// Prisma 7 Schema - AI Client Closing Agent SaaS
// The datasource url is now in prisma.config.ts

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  BOOKING_SENT
  BOOKED
  FOLLOW_UP
  WON
  LOST
  SPAM
}

enum SenderType {
  LEAD
  AGENT
  HUMAN
}

enum FollowUpStatus {
  PENDING
  SENT
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum AppointmentStatus {
  REQUESTED
  BOOKED
  CANCELLED
  COMPLETED
}

enum FunnelOptionIntent {
  ENQUIRY
  BOOKING
  BOTH
}

// 1. Users
model User {
  id            String            @id @default(uuid())
  email         String            @unique
  name          String?
  avatarUrl     String?
  supabaseId    String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  memberships   WorkspaceMember[]
  notifications Notification[]
}

// 2. Workspaces (Allows Agency Multi-Workspace Mode)
model Workspace {
  id                 String             @id @default(uuid())
  name               String
  stripeCustomerId   String?            @unique
  subscriptionPlan   String             @default("STARTER")
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  members            WorkspaceMember[]
  businessProfile    BusinessProfile?
  agentConfig        AgentConfig?
  leads              Lead[]
  notifications      Notification[]
  integrations       Integration[]
  bookingSlots       BookingSlot[]
  appointments       Appointment[]
  knowledgeGaps      KnowledgeGap[]
  funnelOptionPages  FunnelOptionPage[]
}

// 3. Workspace Members
model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        UserRole  @default(MEMBER)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// 4. Business Profiles
model BusinessProfile {
  id             String    @id @default(uuid())
  workspaceId    String    @unique
  name           String
  niche          String
  websiteUrl     String?
  servicesStyle  String?
  pricingStyle   String?
  targetCustomer String?
  location       String?
  contactEmail   String
  contactPhone   String?
  bookingLink    String?
  workingHours   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  services       Service[]
  faqs           FAQ[]
}

// 5. Business Services offered
model Service {
  id                String          @id @default(uuid())
  businessProfileId String
  name              String
  description       String          @default("")
  price             String?
  duration          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
}

// 6. Business FAQs (Knowledge Base for AI Agent)
model FAQ {
  id                String          @id @default(uuid())
  businessProfileId String
  question          String
  answer            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
}

// 7. AI Agent Configuration
model AgentConfig {
  id                   String         @id @default(uuid())
  workspaceId          String         @unique
  name                 String         @default("Sales Assistant")
  tone                 String         @default("professional")
  customInstructions   String?        @db.Text
  bookingLink          String?
  leadScoringRules     String?        @db.Text
  autoFollowUpSettings Json?
  fallbackMessage      String         @default("I apologize, but I am not certain on that. Let me get one of our team members to contact you directly.")
  handoffRules         String?        @db.Text
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  followUpRules        FollowUpRule[]
  conversations        Conversation[]
}

// 8. Leads CRM
model Lead {
  id              String          @id @default(uuid())
  workspaceId     String
  name            String?
  email           String?
  phone           String?
  status          LeadStatus      @default(NEW)
  source          String          @default("chat_widget")
  score           Int             @default(0)
  requirements    String?         @db.Text
  budget          String?
  timeline        String?
  location        String?
  summary         String?         @db.Text
  nextAction      String?         @db.Text
  notes           String?         @db.Text
  lastContactedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  followUpQueue   FollowUpQueue[]
  appointments    Appointment[]

  @@index([workspaceId])
  @@index([email])
}

// 9. Conversations
model Conversation {
  id            String      @id @default(uuid())
  leadId        String
  agentConfigId String
  channel       String      @default("website_chat") // website_chat, email, whatsapp, instagram, facebook
  externalId    String? // For linking to Meta API thread IDs
  status        String      @default("active")
  summary       String?     @db.Text
  nextAction    String?     @db.Text
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([leadId])
}

// 10. Chat Messages
model Message {
  id              String       @id @default(uuid())
  conversationId  String
  senderType      SenderType
  content         String       @db.Text
  externalId      String? // Provider's specific message ID
  channelMetadata Json? // Store channel-specific data (e.g. attachments, whatsapp statuses)
  isRead          Boolean      @default(false)
  createdAt       DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// 11. Follow-up Rules
model FollowUpRule {
  id            String          @id @default(uuid())
  agentConfigId String
  delayHours    Int
  messageTopic  String
  sequenceOrder Int
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  agentConfig   AgentConfig     @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  queueItems    FollowUpQueue[]
}

// 12. Scheduled Follow-up Queue
model FollowUpQueue {
  id            String         @id @default(uuid())
  leadId        String
  ruleId        String
  scheduledFor  DateTime
  status        FollowUpStatus @default(PENDING)
  sentMessageId String?
  createdAt     DateTime       @default(now())
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rule          FollowUpRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, status])
}

// 13. Notifications
model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  title       String
  message     String
  isRead      Boolean   @default(false)
  link        String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// 14. Integrations
model Integration {
  id          String    @id @default(uuid())
  workspaceId String
  provider    String // website_widget, email, whatsapp, instagram, facebook, google_calendar
  config      Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

// 15. Manual booking slots shown on the public AI booking funnel
model BookingSlot {
  id           String        @id @default(uuid())
  workspaceId  String
  title        String
  startsAt     DateTime
  endsAt       DateTime
  timezone     String        @default("UTC")
  capacity     Int           @default(1)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([workspaceId, startsAt])
}

// 16. Appointments requested or booked by the AI booking funnel
model Appointment {
  id             String            @id @default(uuid())
  workspaceId    String
  leadId         String?
  bookingSlotId  String?
  status         AppointmentStatus @default(REQUESTED)
  serviceName    String?
  requestedTime  String?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  leadName       String?
  leadEmail      String?
  leadPhone      String?
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookingSlot    BookingSlot?      @relation(fields: [bookingSlotId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([leadId])
}

// 17. Owner-configurable public funnel option pages
model FunnelOptionPage {
  id          String             @id @default(uuid())
  workspaceId String
  title       String
  subtitle    String?
  intent      FunnelOptionIntent @default(BOTH)
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  options     FunnelOption[]

  @@index([workspaceId, intent, isActive])
}

// 18. Options shown on owner-configurable public funnel pages
model FunnelOption {
  id             String           @id @default(uuid())
  pageId         String
  title          String
  answer         String           @db.Text
  serviceName    String?
  parentOptionId String?
  nextPageId     String?
  finalAction    String           @default("ASK_REQUIREMENT")
  sortOrder      Int              @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  page           FunnelOptionPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, isActive, sortOrder])
  @@index([parentOptionId])
  @@index([nextPageId])
}

// 19. Business knowledge gaps captured when the public assistant cannot answer from saved info
model KnowledgeGap {
  id            String    @id @default(uuid())
  workspaceId   String
  question      String    @db.Text
  answerAttempt String?   @db.Text
  status        String    @default("OPEN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}
model PushSubscription {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
}
